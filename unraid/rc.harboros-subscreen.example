#!/bin/bash

# Draft Unraid host launcher. Keep the safe policy unless the EC mapping and
# Unraid disk-temperature backend have been validated on the target hardware.

set -euo pipefail

PLUGIN_DIR="/boot/config/plugins/harboros-subscreen"
SOURCE_BIN="${PLUGIN_DIR}/harboros-subscreen"
BIN="/usr/local/libexec/harboros-subscreen/harboros-subscreen"
PREFLIGHT="${PLUGIN_DIR}/preflight.sh"
ENV_FILE="${PLUGIN_DIR}/runtime.env"
LOG="/var/log/harboros-subscreen.log"
PIDFILE="/var/run/harboros-subscreen.pid"

running_pid() {
    local pid
    [[ -r "${PIDFILE}" ]] || return 1
    read -r pid < "${PIDFILE}"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    [[ "$(readlink "/proc/${pid}/exe" 2>/dev/null)" == "${BIN}" ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s\n' "$pid"
}

prepare_runtime() {
    [[ -f "${SOURCE_BIN}" ]] || { echo "missing ${SOURCE_BIN}" >&2; return 1; }
    if ! cmp -s "${SOURCE_BIN}" "${BIN}"; then
        if running_pid >/dev/null; then
            echo "stop the running process before replacing its binary" >&2
            return 1
        fi
        install -D -m 0755 "${SOURCE_BIN}" "${BIN}"
    fi
}

load_env() {
    if [[ -r "${ENV_FILE}" ]]; then
        # The file is operator-owned and stays on the Unraid boot device.
        # shellcheck disable=SC1090
        . "${ENV_FILE}"
    fi
    export HARBOR_SUBSCREEN_ALLOW_EC_WRITE="${HARBOR_SUBSCREEN_ALLOW_EC_WRITE:-0}"
    export HARBOR_SUBSCREEN_ALLOW_OTA="${HARBOR_SUBSCREEN_ALLOW_OTA:-0}"
    export HARBOR_SUBSCREEN_ALLOW_SUSPEND="${HARBOR_SUBSCREEN_ALLOW_SUSPEND:-0}"
    export HARBOR_SUBSCREEN_ENABLE_STORAGE="${HARBOR_SUBSCREEN_ENABLE_STORAGE:-0}"
    export HARBOR_SUBSCREEN_FIRMWARE="${HARBOR_SUBSCREEN_FIRMWARE:-${PLUGIN_DIR}/firmware}"
}

preflight() {
    [[ -f "${PREFLIGHT}" ]] || { echo "missing ${PREFLIGHT}" >&2; return 1; }
    prepare_runtime || return 1
    bash "${PREFLIGHT}" "${BIN}" "${2:-}"
}

start() {
    if running_pid >/dev/null; then
        return 0
    fi

    load_env
    preflight start --require-panel || return 1
    touch "${LOG}"

    nohup "${BIN}" </dev/null >>"${LOG}" 2>&1 &
    echo $! >"${PIDFILE}"
    sleep 1
    if ! running_pid >/dev/null; then
        rm -f "${PIDFILE}"
        echo "process exited during startup; see ${LOG}" >&2
        return 1
    fi
}

stop() {
    local pid
    if pid="$(running_pid)"; then
        kill "$pid"
        for _ in {1..45}; do
            running_pid >/dev/null || break
            sleep 1
        done
        if running_pid >/dev/null; then
            echo "process is still shutting down; see ${LOG}" >&2
            return 1
        fi
    fi
    rm -f "${PIDFILE}"
}

status() {
    local pid
    if pid="$(running_pid)"; then
        echo "running pid=${pid}"
        return 0
    fi
    echo "stopped"
    return 1
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status) status ;;
    preflight) preflight "${1:-}" "${2:-}" ;;
    *) echo "usage: $0 {start|stop|restart|status|preflight [--require-panel]}" >&2; exit 2 ;;
esac
