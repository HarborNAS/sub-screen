# Copy to /boot/config/plugins/harboros-subscreen/runtime.env.
# Keep these values until the USB, disk-temperature, and EC checks are complete.
HARBOR_SUBSCREEN_ALLOW_EC_WRITE=0
HARBOR_SUBSCREEN_ALLOW_OTA=0
HARBOR_SUBSCREEN_ALLOW_SUSPEND=0
HARBOR_SUBSCREEN_ENABLE_STORAGE=0
# HARBOR_SUBSCREEN_FIRMWARE=/boot/config/plugins/harboros-subscreen/firmware
